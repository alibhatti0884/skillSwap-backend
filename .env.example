# Rename this file to .env before running the server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# To test on a phone over your LAN, add your computer's IP address too
# (comma-separated, no spaces), e.g.:
# CLIENT_URL=http://localhost:5173,http://192.168.1.5:5173
